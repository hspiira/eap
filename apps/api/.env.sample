# Application Configuration
APP_NAME=Evexía
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Database Configuration
# PostgreSQL is the only supported backend. Defaults to a stock local install;
# change the credentials if yours differ, then re-run `pnpm setup`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/evexia_db
DATABASE_ECHO=false

# Security Configuration
# Generate a secure secret key for production (e.g., using: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-generate-secure-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
