# Test environment configuration: safe to commit; dummy values only, not used in production.
APP_NAME=EAP Test
APP_VERSION=0.0.0-test
DEBUG=false
ENVIRONMENT=test
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eap_test
DATABASE_ECHO=false
SECRET_KEY=test-secret-key-for-ci-only-minimum-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=WARNING

# Tests seed tenants through POST /tenants (see tests/conftest.py), so they opt out
# of the platform-admin requirement that is on by default everywhere else.
# Cross-tenant authorization is not exercised here either way; see Phase 4.1.
REQUIRE_PLATFORM_ADMIN_FOR_TENANT_CREATION=false
