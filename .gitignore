# Repo-wide ignores. Each app keeps its own .gitignore for tooling specific to it.

# Secrets — never commit, at any depth
.env
.env.*
!.env.sample
!.env.test

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tooling caches
.ruff_cache/
.pytest_cache/
.import_linter_cache/
__pycache__/
.coverage
coverage.xml

# Dependencies and build output
.venv/
node_modules/
