# ---------------------------------------------------------------------------
# Evexía: one environment file for the whole monorepo.
#
# `pnpm setup` copies this to `.env`, which is gitignored. Both apps read it:
#
#   apps/api  pydantic-settings reads this file, then apps/api/.env if that
#             exists, so an app-local file can override a value here.
#   apps/web  vite's `envDir` points at the repo root.
#
# IMPORTANT: vite only exposes variables prefixed `VITE_` to the browser
# bundle. Everything else in this file stays server-side. Never rename a
# secret to start with VITE_.
#
# The values marked "paired" appear on both sides and must agree. Keeping
# them in one file is the point: they used to live in two and drift.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=Evexía
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# PostgreSQL is the only supported backend. Defaults to a stock local install;
# change the credentials if yours differ, then re-run `pnpm setup`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/evexia_db
DATABASE_ECHO=false

# --- Security --------------------------------------------------------------
# Generate a real key for anything but local dev: openssl rand -hex 32
SECRET_KEY=change-me-in-production-generate-secure-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Origins (paired) ------------------------------------------------------
# CORS_ORIGINS must contain the origin the frontend is served from, and
# VITE_API_BASE_URL must point at the API. `pnpm dev` runs web on :3000 and
# api on :8000; if you change either port, change it here too.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# --- Frontend --------------------------------------------------------------
VITE_APP_NAME=Evexía
VITE_APP_ENV=development

# Auth transport (paired). Both must carry the same value: the API decides how
# it reads the token, the frontend decides how it sends one. Disagree, and the
# browser logs in fine and is then 401'd on every call after it.
# true  = httpOnly cookies, requires the API on the same site as the frontend
# false = bearer token in JS, for a cross-domain deployment
AUTH_USE_HTTPONLY_COOKIES=true
VITE_AUTH_USE_COOKIES=true

# --- Platform admin (paired) -----------------------------------------------
# The tenant whose users administer every other tenant. The two must be equal:
# the backend enforces the gate, the frontend only shows or hides the UI.
# Leave both empty for single-tenant dev, where everyone sees the admin UI.
PLATFORM_TENANT_ID=
VITE_PLATFORM_TENANT_ID=

# --- Azure AD SSO (paired) -------------------------------------------------
# Setting VITE_AZURE_SSO_ENABLED=true only shows the "Sign in with Microsoft"
# button. It will not work until the four backend values below are set too.
VITE_AZURE_SSO_ENABLED=false
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=
# AZURE_FRONTEND_REDIRECT_URI=
